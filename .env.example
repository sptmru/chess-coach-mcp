# Canonical public HTTPS origin. Local OAuth tests can use http://localhost:8080.
PUBLIC_URL=https://chess.example.com
APP_PORT=8080
POSTGRES_USER=chess
POSTGRES_DB=chess
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
# Leave DATABASE_URL unset for Compose; credentials above are URI-encoded by the app.
# DATABASE_URL=postgresql://...
DB_HOST=localhost
DB_PORT=5432
STOCKFISH_PATH=/usr/games/stockfish
ANALYSIS_DEPTH=12
MAX_DEPTH=16
MAX_MULTIPV=3
ENGINE_POOL_SIZE=1
ENGINE_THREADS=1
ENGINE_HASH_MB=64
ENGINE_TIMEOUT_MS=20000
JOB_CONCURRENCY=1
MAX_ANALYSIS_GAMES=10
MAX_BATCH_ANALYSIS_GAMES=500
# Sync, analyze and classify yesterday's Rapid games at 03:00 Asia/Yerevan.
# Applies to all linked Chess.com identities and uses the configured reasoner.
DAILY_ANALYSIS_ENABLED=true
DAILY_ANALYSIS_POSITIONS_PER_GAME=10
# Use a contact address you control in the Chess.com User-Agent.
CHESSCOM_USER_AGENT=ChessCoachMCP/0.1 (contact: operator@example.com)
# Exact callback URI shown by your MCP client; comma-separated. No wildcards.
OAUTH_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect
# disabled keeps deterministic classification available without any provider traffic.
REASONER_PROVIDER=disabled
# Jev defaults to jev-latest; OpenAI and Gemini require an explicit model.
REASONER_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
JEV_API_KEY=
# Native TypeSafe System One endpoint (also the default when omitted):
JEV_API_URL=https://api.typesafe.ai/v1/systemone
LOG_LEVEL=info
# Local trusted stdio only; never inferred from MCP input:
# STDIO_USER_ID=
